{
  "manifest_version": 3,
  "name": "Bines — side panel",
  "description": "The Bines item card next to the site you chat on (ManyChat, WhatsApp Web, Gmail…). Configured in the platform.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "contextMenus"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Bines"
  }
}
