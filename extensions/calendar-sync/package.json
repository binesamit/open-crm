{
  "name": "@bines/ext-calendar-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bines OS extension with its own server: two-way sync between a board and Google Calendar (a provider interface, so CalDAV can follow)",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup && node scripts/build-pages.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@bines/ext-sdk": "workspace:*",
    "@bines/shared": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "hono": "^4.13.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0",
    "zod": "^4.6.0"
  }
}
