        "formula": "IF(OR({lookup_mm6xf1br}>0,{lookup_mm6xk7pe}>0),\"🔴 אדום\",IF(OR({lookup_mm6xwq5g}>0,{lookup_mm6xce5v}>0),\"🟡 צהוב\",\"🟢 ירוק\"))"
