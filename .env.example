# Copy to .env (never commit .env). Values below match docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://bines:bines@localhost:5433/bines_os

# Auth (T0.3)
BETTER_AUTH_SECRET=change-me-32-chars-minimum-xxxxxxxx
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional fallback for "Continue with Microsoft" (normally set in the owner console → sign-in providers)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Web Push (phone app, the planning notes "PWA") — optional. Unset: the API creates a VAPID key pair once and keeps it in
# platform_settings (row "vapid"); api and worker read it from there. Set both (base64url) to pin your own pair —
# e.g. `npx web-push generate-vapid-keys`. Changing the pair makes every phone subscribe again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact of the push sender (mailto: or https:); default = WEB_ORIGIN.
VAPID_SUBJECT=

# Seed — this user becomes platform owner (D12) and is invited as admin of the first account.
SEED_ADMIN_EMAIL=admin@example.com
# The first account — created only when the database has no account at all (never again, even after a rename).
# Local E2E specs expect slug "demo" and SEED_ADMIN_EMAIL as the owner.
SEED_ACCOUNT_NAME=Demo
SEED_ACCOUNT_SLUG=demo
# The opening kit: `default` (the catalogue's default starter pack), `empty`, or a starter pack key (seed/packs).
SEED_TEMPLATE_SET=default
# The help center that ships with the code (seed/help: articles, practical guides, guided tours) is loaded once on a
# new installation's first boot; an installation that already has articles is left alone. false = start empty.
# HELP_SEED=false
# HELP_SEED_DIR=../../seed/help
# Round 13: where the catalogue's sample extensions (extensions/catalog — "סיכום בורד", "סטטיסטיקת קנבן") are served.
# Their OWN origin, never WEB_ORIGIN. Locally: `node extensions/catalog/serve.mjs` then `pnpm db:seed`. Unset = not in
# the catalogue (the CRM starter pack is always there).
# SAMPLE_EXTENSIONS_ORIGIN=http://127.0.0.1:3997

# Client address behind the proxy (S-10): edge (Railway — first X-Forwarded-For entry), a hop count, or none.
TRUST_PROXY=edge
# CLIENT_IP_HEADER=x-forwarded-for
# Rate limits (06 §1.10; 0 = off)
# RATE_LIMIT_IP_PER_10S=5000
# RATE_LIMIT_ACCOUNT_PER_MIN=3000
# INVITE_EMAILS_PER_HOUR=50

# Public API reference (/api/docs) white-label - FALLBACK ONLY: the owner console (Platform settings) sets the product
# name, logo and brand colour; these apply when a field there is empty (product name default: i18n app.name).
# PRODUCT_NAME=
# API_DOCS_LOGO_URL=
# API_DOCS_BRAND_COLOR=#0d3b35

# Files: MinIO locally; production uses Cloudflare R2 (S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com,
# S3_REGION=auto, S3_SET_CORS=false — CORS is set with wrangler)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bines-os
S3_ACCESS_KEY_ID=bines
S3_SECRET_ACCESS_KEY=bines-secret

# Email (Mailpit locally; Resend or plain SMTP in production)
MAILPIT_URL=http://localhost:8025
# The sending ADDRESS only (verified with Resend). The sender NAME is a setting: the account's (Administration ->
# General -> Emails & SMS, default = the account name) or the platform's (owner console) - never a brand here.
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=
RESEND_FROM=
# Incoming email to items and boards: the signing secret of Resend's `email.received` webhook (whsec_...), pointed at
# <API origin>/api/v1/hooks/email/resend. The inbound domain itself is a setting (owner console -> Platform settings
# -> Emails); each account turns it on in Administration -> Connections. Unset secret = every call is refused.
# RESEND_INBOUND_API_KEY: a key that may read received mail (else RESEND_API_KEY).
RESEND_INBOUND_SECRET=
RESEND_INBOUND_API_KEY=
# RESEND_API_BASE: the receiving API's address (empty = Resend's; a compatible provider, or the E2E stand-in).
RESEND_API_BASE=
# Plain SMTP to any server (your own Postfix, Amazon SES, Postmark, Mailgun, Gmail, ...): used when SMTP_HOST is set
# and RESEND_API_KEY is not. The sending address is EMAIL_FROM. Order when several are set: Resend, SMTP, Mailpit;
# EMAIL_TRANSPORT (resend | smtp | mailpit | none) forces one. No transport at all = email is off: said once in the
# log at startup, each email is logged (never its body) and not sent - nothing crashes.
SMTP_HOST=
# 587 = STARTTLS (default), 465 = TLS from the first byte, 25 / 2525 = whatever your server offers.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# true = implicit TLS (port 465). Empty = true only when SMTP_PORT is 465.
SMTP_SECURE=
# Empty = STARTTLS must succeed (except a relay on localhost); false = allow cleartext (trusted relay only).
SMTP_REQUIRE_TLS=
# EMAIL_TRANSPORT=
# SMS — TextMe
TEXTME_API_KEY=
TEXTME_USERNAME=
# Fallback only: each account (Administration) and the platform (owner console) choose their SMS sender id.
# No sender anywhere = every SMS fails (error 'sms: sender_not_configured', logged; owner console shows a warning).
TEXTME_SENDER_ID=

# =====================================================================================================================
# SELF-HOSTING - docker-compose.prod.yml (full guide: docs/SELF-HOSTING.md)
#
# Everything ABOVE is for local development (`pnpm dev`). The production stack reads this file too, but sets
# NODE_ENV, LOG_LEVEL, DATABASE_URL, WEB_ORIGIN, BETTER_AUTH_*, SEED_*, TRUST_PROXY, S3_* and MAILPIT_URL itself from
# the variables below, so the development values above never apply to it. Taken from above as they are (all
# optional): EMAIL_FROM, SMTP_*, EMAIL_TRANSPORT, RESEND_*, GOOGLE_CLIENT_*, VAPID_*, TEXTME_*, rate limits.
# Required values below are empty on purpose: `docker compose` refuses to start and names the one that is missing.
# Never commit the filled-in .env.
# =====================================================================================================================

# The address people open in the browser: scheme + host (+ port), no trailing slash. Email links and sign-in cookies
# use it. Behind a reverse proxy with TLS, e.g. https://work.example.com
APP_URL=http://localhost:3000
# The host port the app is published on (inside the container it is always 3000).
APP_PORT=3000

# REQUIRED. The first administrator: becomes platform owner on first sign-in and is invited as admin of the first
# account (docs/SELF-HOSTING.md "First admin account").
ADMIN_EMAIL=
# The first account - created only when the database has no account at all.
FIRST_ACCOUNT_NAME=Main
# Lower-case letters, digits and dashes; part of the account's URLs.
FIRST_ACCOUNT_SLUG=main
# Starter kit of the first account: a catalogue pack key, `empty`, or empty = the default kit.
FIRST_ACCOUNT_KIT=

# REQUIRED secrets. Generate each one ONCE and keep a copy somewhere safe, outside the server.
# Session signing key, at least 32 characters. Changing it signs everyone out.
#   openssl rand -base64 48
AUTH_SECRET=
# Encrypts secret columns and stored connection keys (32 bytes). Losing it loses every encrypted value.
#   openssl rand -base64 32
SECRET_MASTER_KEY=

# PostgreSQL 18 (the bundled container; data in the `pgdata` volume).
POSTGRES_USER=bines
POSTGRES_DB=bines_os
# REQUIRED. Hex only - it goes into a connection URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# File storage. Default: the bundled MinIO (profile `minio`; data in the `miniodata` volume, bucket created on start).
# Compose profiles to start; empty = no MinIO (use an external S3 below).
COMPOSE_PROFILES=minio
STORAGE_BUCKET=files
# The S3 access key: MinIO's admin user, or your external S3 key.
STORAGE_ACCESS_KEY=bines
# REQUIRED. MinIO's admin password, or your external S3 secret.
#   openssl rand -hex 24
STORAGE_SECRET_KEY=
# Where BROWSERS reach the storage: uploads and downloads go there directly, with short-lived signed URLs.
# Bundled MinIO: http://<host>:MINIO_PORT, or https://files.example.com when proxied. External S3: leave empty.
STORAGE_PUBLIC_URL=http://localhost:9000
# The host port MinIO is published on.
MINIO_PORT=9000
# External S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, Wasabi, ...): set COMPOSE_PROFILES= (empty),
# STORAGE_PUBLIC_URL= (empty) and these. Unset = the bundled MinIO (http://minio:9000).
# STORAGE_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# Region of the bucket (R2: auto). Default us-east-1.
# STORAGE_REGION=eu-central-1
# true = path-style URLs (MinIO, most S3-compatibles); false = virtual-hosted (AWS). Default true.
# STORAGE_FORCE_PATH_STYLE=false
# true = the app sets the bucket's CORS to APP_URL at startup. MinIO allows any origin already; R2 needs it set by
# hand. Default false.
# STORAGE_SET_CORS=true

# How many reverse proxies of yours sit in front of the app (1 for one Caddy / nginx / Traefik). `none` = the app is
# reached directly and forwarded headers are ignored. Wrong values let clients fake their address in rate limits.
PROXY_HOPS=none
# Log level: fatal | error | warn | info | debug | trace.
APP_LOG_LEVEL=info
# A prebuilt image to run instead of building one locally (bines-os:local).
# APP_IMAGE=
# Error monitoring (GlitchTip / Sentry protocol), optional: the api / worker DSN. The web app's DSN is a build
# argument: VITE_SENTRY_DSN (baked into the browser app when the image is built).
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# Optional: the calendar-sync extension (two-way Google Calendar sync) — docs/SELF-HOSTING.md "Connecting Google
# Calendar". Add `calendar-sync` to COMPOSE_PROFILES to start it.
# Its own https address (behind your proxy), e.g. https://calendar.example.com
# CALSYNC_PUBLIC_URL=
# REQUIRED with the profile: encrypts the stored Google tokens and secrets.
#   openssl rand -base64 32
# CALSYNC_ENCRYPTION_KEY=
# The host port it is published on (point your proxy at it).
# CALSYNC_PORT=127.0.0.1:3990
# Optional default Google OAuth client for every account (an account admin can also enter their own in the
# extension's settings page): Google Cloud → Credentials → OAuth client ID (Web application).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Licensing (docs/LICENSING.md). Optional registration: the license server this installation registers with (the
# owner console's setting wins). Empty = registration unavailable — keys can still be pasted.
# LICENSE_SERVER_URL=
# Telemetry is OFF by default (the owner console can opt in to a daily heartbeat: version, active users, boards).
# false = never sent, whatever the console says. BINES_UPDATE_CHECK=false = no online key / update check either.
# BINES_TELEMETRY=false
# BINES_UPDATE_CHECK=false
# A license server's Ed25519 signing key (`pnpm license:keygen`) — optional: the owner console can create one instead
# (Licensing → License server), and the console's key wins when both exist.
# LICENSE_SIGNING_KEY=

# Local development only: outgoing webhooks / automation and extension calls / flows / MCP servers may reach
# private and loopback addresses (localhost test servers). Never in production (the API refuses to start).
# OUTBOUND_ALLOW_PRIVATE=1
