{
  "name": "bines-os-platform",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Bines OS — a self-hosted work management platform (boards, CRM, projects, client portal; multi-account, Hebrew-first)",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binesamit/open-crm.git"
  },
  "homepage": "https://github.com/binesamit/open-crm#readme",
  "bugs": {
    "url": "https://github.com/binesamit/open-crm/issues"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:columns": "tsx scripts/gen-column-catalog.ts",
    "docs:check": "tsx scripts/gen-column-catalog.ts --check",
    "check:licenses": "node scripts/check-licenses.mjs",
    "licenses:notices": "node scripts/check-licenses.mjs --write-notices",
    "license:keygen": "node scripts/license-tool.mjs keygen",
    "license:sign": "node scripts/license-tool.mjs sign",
    "db:generate": "pnpm --filter @bines/api db:generate",
    "db:migrate": "pnpm --filter @bines/api db:migrate",
    "db:seed": "pnpm --filter @bines/api db:seed",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:parallel": "node e2e/run-parallel.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@bines/shared": "workspace:*",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "zod": "^4.6.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "^0.28.2",
      "@esbuild-kit/core-utils>esbuild": "^0.25.12",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "lodash@<4.18.0": "^4.18.1",
      "undici@>=4.2.1 <6.29.1": "^6.29.1",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "@ai-sdk/provider-utils@>=4.0.0-beta.10 <4.0.33": "^4.0.33"
    }
  }
}
