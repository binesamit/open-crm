{
  "name": "@bines/api",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "first-admin-link": "tsx src/db/first-admin-link.ts",
    "automations:seed": "tsx scripts/seed-automations.ts",
    "automations:fix-mcp": "tsx scripts/fix-mcp-automations.ts",
    "phone:backfill": "tsx scripts/backfill-phone-e164.ts",
    "perf:seed": "tsx scripts/perf-seed.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "docs:extensions": "tsx scripts/gen-extension-docs.ts",
    "docs:guide": "tsx scripts/gen-install-guide.ts",
    "release": "node dist/migrate.js && node dist/seed.js",
    "start:standalone": "node dist/standalone.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@bines/server-ai": "workspace:^",
    "@bines/server-crypto": "workspace:*",
    "@bines/server-mail": "workspace:*",
    "@bines/server-monitoring": "workspace:*",
    "@bines/shared": "workspace:*",
    "@bines/worker": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@hocuspocus/server": "^4.7.0",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-openapi": "^1.6.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@scalar/api-reference": "1.73.0",
    "@sentry/node": "^11.4.0",
    "better-auth": "^1.7.7",
    "bidi-js": "1.1.0",
    "crossws": "^0.4.12",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "graphile-worker": "^0.18.0",
    "hono": "^4.13.0",
    "jpeg-js": "^0.4.4",
    "nodemailer": "^10.0.10",
    "parse5": "7.3.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.3.0",
    "pngjs": "^7.0.0",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@bines/sdk": "workspace:^",
    "@hocuspocus/provider": "^4.7.0",
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
